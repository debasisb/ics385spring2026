# ============================================================
# UH Maui Campus Dashboard – Environment Variables Template
# IMPORTANT: Copy this file to .env and fill in your keys.
#            NEVER commit the .env file to version control!
# ============================================================

# OpenWeatherMap API Configuration
# Sign up free at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# RapidAPI Configuration – Chuck Norris Jokes
# Subscribe (free) at https://rapidapi.com/matchilling/api/chuck-norris
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=matchilling-chuck-norris-jokes-v1.p.rapidapi.com

# Application Configuration
APP_NAME=UH Maui Campus Dashboard
DEFAULT_CITY=Kahului
CACHE_DURATION=600000
API_TIMEOUT=5000

# Development Settings
DEBUG_MODE=true
LOG_LEVEL=info
